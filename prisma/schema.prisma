generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model user {
  id_user          Int               @id @default(autoincrement())
  nama_user        String            @unique @db.VarChar(100)
  role_user        String            @db.VarChar(100)
  email            String            @db.VarChar(100)
  password         String            @db.VarChar(100)
  cv               String?           @db.VarChar(255)
  no_telp          String?           @db.VarChar(20)

  pendaftaran      pendaftaran[]
  profil_freelance profil_freelance?
  laporan          laporan[]
}

model profil_freelance {
  id_profil_freelance Int     @id @default(autoincrement())
  id_user             Int     @unique
  headline            String? @db.VarChar(255)
  bio                 String? @db.VarChar(1000)
  linkedin            String? @db.VarChar(255)

  user                user    @relation(fields: [id_user], references: [id_user], onDelete: Cascade)
}

model project {
  id_project        Int      @id @default(autoincrement())
  nama_project      String   @db.VarChar(100)
  pembuat           String   @db.VarChar(100)
  id_user           String   @db.VarChar(255)
  role_project      String   @db.VarChar(255)
  bayaran           Int
  tgl_mulai         DateTime @db.DateTime
  deadline          DateTime @db.DateTime
  status_project    String   @db.VarChar(100)
  deskripsi_project String @db.VarChar(255)

  pendaftaran pendaftaran[]

  @@index([pembuat])
  @@index([id_user])
  @@index([nama_project, role_project])
}

model laporan {
  id_laporan         Int    @id @default(autoincrement())
  nama_project       String @db.VarChar(100)
  nama_user          String @db.VarChar(100)
  id_user            Int?
  role_project       String @db.VarChar(255)
  bukti              String @db.VarChar(255)
  jenis_laporan      String @db.VarChar(100)
  deskripsi_laporan  String @db.VarChar(255)
  status_laporan     String @db.VarChar(50) @default("pending")

  user user? @relation(fields: [id_user], references: [id_user], onDelete: SetNull)

  @@index([nama_user])
  @@index([id_user])
  @@index([nama_project, role_project])
}

model pendaftaran {
  id_pendaftaran Int      @id @default(autoincrement())
  id_project     Int
  id_user        Int
  role_project   String   @db.VarChar(255)
  status         String   @db.VarChar(50) @default("pending")
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  project project @relation(fields: [id_project], references: [id_project], onDelete: Cascade)
  user    user    @relation(fields: [id_user], references: [id_user], onDelete: Cascade)

  @@index([id_project])
  @@index([id_user])
  @@unique([id_project, id_user, role_project])
}
